# Copie para ".env" (nao versionado) e ajuste. O docker compose le este arquivo automaticamente.

# --- API ---
API_PORT=8080
# Segredo de assinatura dos tokens JWT (HS256): minimo 32 caracteres. Gere um novo, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres
JWT_EXPIRATION_MINUTES=480

# Cria os usuarios de teste (vinicius/anna/gabriela, senha 123456) e dados de exemplo se o banco estiver vazio.
# O padrao da aplicacao ja e false (fail-safe) se esta variavel nao for definida; o docker-compose
# deste ambiente de desenvolvimento liga explicitamente. NUNCA true em producao.
APP_SEED_ENABLED=true
# true = o cadastro publico aceita escolher o perfil (comportamento do app da Sprint 1).
# false = todo cadastro publico vira OPERADOR e so a LIDERANCA promove usuarios.
APP_ALLOW_ROLE_SELECTION=true

# Limite de requisicoes por minuto (protege login contra forca bruta e os endpoints de IA
# contra abuso de custo). Chave: e-mail no login, id do usuario autenticado na IA.
RATE_LIMIT_LOGIN_POR_MINUTO=10
RATE_LIMIT_IA_POR_MINUTO=10

# Teto de documentos lidos por agregacao do dashboard (nao carregar a colecao inteira na memoria).
DASHBOARD_LIMITE_REGISTROS=5000

# --- IA generativa (opcional: sem chave, a pontuacao e os insights usam regras locais) ---
AI_ENABLED=true
# gemini  -> Google Gemini API (chave gratuita em https://aistudio.google.com/apikey)
# openai  -> qualquer API compativel com OpenAI: OpenRouter (padrao) ou GitHub Models
AI_PROVIDER=gemini
AI_API_KEY=
# Os nomes de modelo mudam com frequencia: confira a lista atual do provedor.
AI_MODEL=gemini-3.6-flash
# Vazio = URL padrao do provedor. Exemplos para AI_PROVIDER=openai:
#   OpenRouter    https://openrouter.ai/api/v1       (modelo ex.: ...:free)
#   GitHub Models https://models.github.ai/inference (modelo ex.: openai/gpt-4.1-mini)
AI_BASE_URL=
